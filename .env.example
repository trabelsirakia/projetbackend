PORT=8200
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/talentwave_live

# JWT
JWT_SECRET=remplacer_par_48_octets_aleatoires_base64url_au_moins_32_caracteres
JWT_REFRESH_SECRET=remplacer_par_48_octets_aleatoires_base64url_au_moins_32_caracteres
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# SMTP (Gmail, mot de passe d application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_adresse@gmail.com
SMTP_PASSWORD=mot_de_passe_application_gmail_16_lettres
MAIL_FROM=votre_adresse@gmail.com
# Facultatif : redirige TOUS les e-mails (et invitations Agenda) vers cette adresse, le sujet garde le destinataire prevu
MAIL_REDIRECT_TO=

# Interface (CORS + liens des e-mails)
FRONTEND_URL=http://localhost:5175
VITE_API_TARGET=http://localhost:8200

# IA locale (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Reconnaissance vocale (Whisper, Hugging Face, telecharge par npm run models)
WHISPER_MODEL=Xenova/whisper-small

# Google Meet (optionnel) : sans ces 3 valeurs, un lien de visioconference Jitsi est genere a la place
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
